{
  "subagent-efficiency": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node ./scripts/session-start.js",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|manage_task|schedule|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/pre-tool-gate.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
